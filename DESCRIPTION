Package: rapidcycler
Title: Rapid Cycle Analysis (RCA) for a Global Network
Version: 1.3
Date: 2026-04-10
Authors@R: 
    person(given = "Benjamin", family = "Atkins", email = "ben.atkins@mcri.edu.au", role = c("aut", "cre"),
